{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "paths": {
            "~/*": ["./src/*"],
            "~assets/*": ["./assets/*"]
        },
        "rootDirs": ["."],
        "types": ["vite/client", "vitest"]
    },
    "extends": "@nixysoftware/tsconfig/react",
    "include": ["eslint.config.mjs", "vite.config.ts", "src/"]
}
